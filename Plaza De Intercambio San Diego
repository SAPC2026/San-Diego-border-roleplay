local function escapeHtml(s)
	s = tostring(s)
	s = s:gsub("&", "&amp;")
	s = s:gsub("<", "&lt;")
	s = s:gsub(">", "&gt;")
	return s
end

local function httpGet(url)
	if request then
		local ok, res = pcall(function() return request({Url = url, Method = "GET"}) end)
		if ok and res then return res end
	end
	if syn and syn.request then
		local ok, res = pcall(function() return syn.request({Url = url, Method = "GET"}) end)
		if ok and res then return res end
	end
	if http_request then
		local ok, res = pcall(function() return http_request({Url = url, Method = "GET"}) end)
		if ok and res then return res end
	end
	local ok, res = pcall(function() return game:HttpGet(url) end)
	if ok then return res end
	return nil
end

local function EnviarTelegram()
	local placeId = game.PlaceId
	local jobId = game.JobId

	local scriptUnirse = string.format(
		'game:GetService("TeleportService"):TeleportToPlaceInstance(%s, "%s", game.Players.LocalPlayer)',
		tostring(placeId),
		tostring(jobId)
	)

	-- URL HTTPS que la app de Roblox intercepta y abre directo al servidor
	local serverLink = string.format(
		"https://www.roblox.com/games/start?placeId=%s&gameInstanceId=%s",
		tostring(placeId),
		tostring(jobId)
	)

	local gameLink = string.format(
		"https://www.roblox.com/games/%s",
		tostring(placeId)
	)

	local mensaje = string.format("<pre>%s</pre>", escapeHtml(scriptUnirse))

	local keyboard = {
		inline_keyboard = {
			{
				{
					text = "📋 Copiar código",
					copy_text = { text = scriptUnirse }
				}
			},
			{
				{
					text = "🚀 Abrir servidor exacto",
					url = serverLink
				}
			},
			{
				{
					text = "🌐 Abrir juego (si falla)",
					url = gameLink
				}
			}
		}
	}

	local replyMarkup = HttpService:JSONEncode(keyboard)

	local url = string.format(
		"https://api.telegram.org/bot%s/sendMessage?chat_id=%s&text=%s&parse_mode=HTML&disable_web_page_preview=true&reply_markup=%s",
		TELEGRAM_TOKEN,
		TELEGRAM_CHAT_ID,
		HttpService:UrlEncode(mensaje),
		HttpService:UrlEncode(replyMarkup)
	)

	print("[TG] Enviando...")
	local res = httpGet(url)
	if res then
		print("[TG] ✅ Enviado.")
		print("[TG] Respuesta: " .. tostring(res))
	else
		warn("[TG] ❌ Falló.")
	end
end

