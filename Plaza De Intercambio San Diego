print("--- INICIANDO PRICE SPOOFER SILENCIOSO ---")

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Configuración automática (Sin botones)
local priceHackEnabled = true -- Se activa solo al ejecutar
local visualSpoofEnabled = true -- Se activa solo al ejecutar

-- ==========================================
-- HOOK PROTEGIDO (SIN UI, DIRECTO AL GRANO)
-- ==========================================
local hookSuccess, hookError = pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        
        -- Verificamos si es una llamada al servidor
        if priceHackEnabled and method == "InvokeServer" then
            -- Verificamos si es el remote exacto del Trading Hub
            if self.Name == "SetListings" and self.Parent and self.Parent.Name == "TradingHubService" then
                
                local args = {...}
                local originalPrice = nil
                
                -- Función recursiva para encontrar y modificar el precio
                local function modifyPrice(tbl)
                    for k, v in pairs(tbl) do
                        if type(v) == "table" then
                            if v.Price and type(v.Price) == "number" then
                                originalPrice = v.Price -- Guardamos tu precio real (ej. 15)
                                v.Price = 1 -- Enviamos 1 al servidor
                            else
                                modifyPrice(v) -- Seguir buscando en tablas anidadas
                            end
                        end
                    end
                end
                
                modifyPrice(args)
                
                if originalPrice then
                    print("--- ✅ ENVIADO AL SERVIDOR: $1 | TU PRECIO: $" .. originalPrice .. " ---")
                    
                    -- SPOOF VISUAL (Ocultar el $1 y devolverte tu precio original)
                    if visualSpoofEnabled then
                        task.spawn(function()
                            -- Esperamos un momento a que la UI del juego se actualice con el $1
                            task.wait(0.4) 
                            
                            -- Buscamos en toda la interfaz el texto "1" o "$1" y lo cambiamos
                            for _, gui in ipairs(PlayerGui:GetDescendants()) do
                                if (gui:IsA("TextLabel") or gui:IsA("TextBox")) then
                                    if gui.Text == "1" then
                                        gui.Text = tostring(originalPrice)
                                    elseif gui.Text == "$1" then
                                        gui.Text = "$" .. tostring(originalPrice)
                                    end
                                end
                            end
                        end)
                    end
                    
                    -- Enviamos los argumentos modificados al servidor
                    return oldNamecall(self, table.unpack(args))
                end
            end
        end
        
        -- Si no es el remote o el hack está apagado, dejamos pasar la llamada normal
        return oldNamecall(self, ...)
    end)
end)

if hookSuccess then
    print("--- ✅ SCRIPT ACTIVADO. Ve al Trading Hub y pon algo a la venta. ---")
else
    warn("❌ ERROR: Tu ejecutor no soporta hookmetamethod o el juego lo bloqueó.")
    warn("Detalles: " .. tostring(hookError))
end
